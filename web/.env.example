# Copy to .env and fill in — src/chain/config.ts requires every one of these (except the last),
# none are hardcoded fallbacks in source. Vite loads .env automatically; restart
# `npm run dev -w web` after editing it. Only VITE_-prefixed vars reach browser code.

# Where lib/gateway.ts sends GET/POST /services and GET /s/:id. Point this at a deployed
# gateway, or leave it as-is for a local `npm run dev -w gateway`.
VITE_M402_GATEWAY_URL=http://localhost:8787

# Persistent Preview vault deployed 2026-08-07 (contracts/README.md). Must match gateway's
# VAULT_ADDRESS and the agent's M402_VAULT_ADDRESS.
VITE_M402_VAULT_ADDRESS=17b4cf15ad768fa0e5090da960e86eaf7cc885f86eb5a6b241e2fd28d98546ae

VITE_M402_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_M402_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Optional. The proof server URI is normally derived from the connected wallet's
# substrateNodeUri, port 6300 (chain/providers.ts). Only set this if yours runs elsewhere.
# VITE_M402_PROOF_SERVER=http://127.0.0.1:6300
