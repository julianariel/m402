// Throwaway probe for issue #1. Not part of the vault.
// Question: can withdraw pay a Lace address with no merchant secret and no caller auth?
pragma language_version 0.23;

import CompactStandardLibrary;

// The spendable pot lives in private state, not the ledger. Putting a
// QualifiedShieldedCoinInfo in a ledger cell would publish its `value`.
witness vaultCoin(): QualifiedShieldedCoinInfo;

// serviceOwner holds the merchant's Zswap coin public key, taken from their Lace address.
export ledger serviceOwner:    Map<Bytes<32>, Bytes<32>>;
export ledger merchantBalance: Map<Bytes<32>, Uint<64>>;

// No caller authentication. The payout destination is read from the ledger, so the
// funds can only ever reach the registered merchant no matter who submits this.
export circuit withdraw(serviceId: Bytes<32>, amount: Uint<64>): [] {
  assert(serviceOwner.member(disclose(serviceId)), "unknown service");
  const owner = serviceOwner.lookup(disclose(serviceId));

  assert(merchantBalance.member(owner), "no balance");
  const balance = merchantBalance.lookup(owner);
  assert(balance >= disclose(amount), "insufficient balance");

  const pot = vaultCoin();
  sendShielded(
    disclose(pot),
    left<ZswapCoinPublicKey, ContractAddress>(ZswapCoinPublicKey { bytes: owner }),
    disclose(amount) as Uint<128>
  );

  merchantBalance.insert(owner, (balance - disclose(amount)) as Uint<64>);
}
