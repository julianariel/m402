# Copy to .env and fill in — src/config.ts requires every one of these except
# RELAYER_MAX_PAYMENT/RELAY_TARGET_ALLOWLIST, which default safely. See README.md for what
# each does.

PORT=8787

# Persistent Preview vault deployed 2026-08-07 (contracts/README.md). Must match web's
# VITE_M402_VAULT_ADDRESS and the agent's M402_VAULT_ADDRESS — a payment to a different vault
# lands where this gateway isn't watching.
VAULT_ADDRESS=17b4cf15ad768fa0e5090da960e86eaf7cc885f86eb5a6b241e2fd28d98546ae

DB_PATH=gateway.db

INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Path to a file holding the relayer's private key — the FILE PATH, never the key itself. Only
# read when a relay-type service is actually dispatched; irrelevant for an origin-only gateway,
# but still required to boot. Point it at a file that doesn't need to exist yet if you have none.
RELAYER_KEY_FILE=./relayer.key

# Optional — default 100000 (0.10 USDC) if unset. Maximum external payment per relay request,
# in USDC base units.
# RELAYER_MAX_PAYMENT=100000

# Optional — default empty (denies all relay registrations) if unset. Comma-separated exact
# external URLs accepted for relay registration. Keep curated before funding the relayer.
# RELAY_TARGET_ALLOWLIST=

# How long /s/:id waits for a payment receipt to appear on the indexer before returning
# 503 payment-pending.
VERIFY_TIMEOUT_MS=60000
